---
interface Props { name: 'heart' | 'question' | 'arrow' }
const { name } = Astro.props;
---
<svg width="22" height="22" viewBox="0 0 24 24" fill={name === 'question' ? 'currentColor' : 'none'} stroke={name === 'question' ? 'none' : 'currentColor'} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'heart' && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />}
  {name === 'question' && (
    <path fill-rule="evenodd" d="M12 1.5 15.15 4.1 19.25 4.75 19.9 8.85 22.5 12 19.9 15.15 19.25 19.25 15.15 19.9 12 22.5 8.85 19.9 4.75 19.25 4.1 15.15 1.5 12 4.1 8.85 4.75 4.75 8.85 4.1Z M8 8.9C8 6.8 9.5 5.5 12 5.5S16 6.9 16 8.8C16 10.5 15 11.4 13.6 12.3L13 12.7V14H10.8V11.7L12.3 10.8C13.2 10.3 13.8 9.7 13.8 8.9S13.1 7.6 12 7.6 10.3 8.1 10.2 8.9Z M10.8 16H13.2V18.4H10.8Z" />
  )}
  {name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6" /></>}
</svg>
