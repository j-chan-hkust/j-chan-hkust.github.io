---
interface Props { name: 'heart' | 'question' | 'arrow' }
const { name } = Astro.props;
---
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'heart' && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />}
  {name === 'question' && <><circle cx="12" cy="12" r="9" /><path d="M9.6 8.7a2.6 2.6 0 1 1 4.5 1.7c-1 .8-2.1 1.1-2.1 2.8" /><path d="M12 16.5h.01" /></>}
  {name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6" /></>}
</svg>
