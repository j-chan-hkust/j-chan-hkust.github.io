---
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Jung Chan — all posts">Jung Chan</a>
  <nav class="main-nav" aria-label="Main navigation">
    <a class="writing-link" href="/" aria-current={pathname === '/' || pathname.startsWith('/tags/') ? 'page' : undefined}>Writing</a>
    <a class="icon-link" href="/other-peoples-stuff/" aria-label="other people's stuff" title="other people's stuff" aria-current={pathname === '/other-peoples-stuff/' ? 'page' : undefined}><Icon name="heart" /></a>
    <a class="icon-link" href="/about/" aria-label="About me" title="About me" aria-current={pathname === '/about/' ? 'page' : undefined}><Icon name="question" /></a>
  </nav>
</header>
