---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Site from './Site.astro';
import { getPosts, tagsFor, tagKey, tagSlug, dateLabel } from '../lib/posts';
type Props = CollectionEntry<'blog'>['data'] & { noindex?: boolean };
const { title, description, pubDate, updatedDate, heroImage, tags = [], noindex = false } = Astro.props;
const publicTags = new Set(tagsFor(await getPosts()).map(tag => tag.key));
---
<Site title={title} description={description} image={heroImage} noindex={noindex} article>
  <article class="reading-page">
    <a class="back-link" href="/">← All writing</a>
    <header class="reading-heading">
      <p class="eyebrow">A NOTE BY JUNG CHAN</p>
      <p class="reading-date"><time datetime={pubDate.toISOString()}>{dateLabel(pubDate)}</time>{updatedDate && <span> · Updated <time datetime={updatedDate.toISOString()}>{dateLabel(updatedDate)}</time></span>}</p>
      <h1>{title}</h1>
      {tags.length > 0 && <ul class="post-tags" aria-label="Post tags">{tags.map(tag => <li>{publicTags.has(tagKey(tag)) ? <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a> : <span>{tag}</span>}</li>)}</ul>}
    </header>
    {heroImage && <Image class="hero-image" src={heroImage} alt="" width={1100} />}
    <div class="prose"><slot /></div>
    <div class="reading-end"><span aria-hidden="true">✳</span><a href="/">Back to all writing</a></div>
  </article>
</Site>
